# ==============================================================================
# NightGuard Environment Variables Template
# Copy this file to .env in your development or production environment
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Security & Authentication
# Generate a strong 32-byte secret for JWT (e.g. openssl rand -hex 32)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
# Generate a 32-byte key for AES-256-GCM router credential encryption (hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=session_signing_secret_key_nightguard_secure_token

# Public Frontend & API URLs
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
WEB_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://nightguard:nightguard_pass@localhost:5432/nightguard?schema=public

# Redis Configuration (For BullMQ scheduling & distributed locks)
REDIS_URL=redis://localhost:6379

# Router Gateway & Agent Configuration
ROUTER_AGENT_SHARED_SECRET=nightguard_agent_communication_secret_token_123
ROUTER_HEARTBEAT_TIMEOUT_SEC=90
ROUTER_COMMAND_TIMEOUT_SEC=15

# Default Admin User (For initial DB seeding)
DEFAULT_ADMIN_EMAIL=admin@nightguard.local
DEFAULT_ADMIN_PASSWORD=AdminSecurePassword123!
